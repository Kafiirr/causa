{
  "name": "causa-lab",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "An evidence-first diagnostic lab for physical systems.",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node scripts/browser-check.cjs",
    "check": "node --check public/app.js && node --check public/engine.js && node --check public/rig.js && node --check public/perception.js && node --check server/perception.mjs",
    "build": "node scripts/run-framework.mjs build",
    "dev:worker": "node scripts/run-framework.mjs dev",
    "install:ci": "node scripts/install-ci.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@meta-sam/parser": "0.1.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
